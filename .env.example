# Docling 解析 API 仅绑定本机。生产环境通过 HTTPS 反向代理访问。
DOCLING_PORT=5001
DOCLING_DEVICE=cpu

# 企业公开品牌配置；真实商家复制示例为被忽略的 enterprise.local.json。
ENTERPRISE_CONFIG_PATH=config/enterprise.example.json

# 完成 Dify 管理员初始化并创建知识库 API Key 后再填写。
DIFY_BASE_URL=http://127.0.0.1:8081
DIFY_CONSOLE_PUBLIC_URL=http://127.0.0.1:8081
# Docling/AI 服务运行在 Docker 内时使用宿主机地址。
DIFY_DOCKER_BASE_URL=http://host.docker.internal:8081
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
# DeepSeek 不提供 embedding API，第一版先用 economy；接入 embedding 模型后改为 high_quality。
DIFY_INDEXING_TECHNIQUE=economy

# Dify Chatflow 应用级密钥，仅供服务端调用，不要放入网页代码。
DIFY_APP_ID=
DIFY_APP_API_KEY=

# Chatwoot AI 客服编排。API Token 与 Webhook Secret 仅保存在服务端。
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_PUBLIC_BASE_URL=http://127.0.0.1:3000
CHATWOOT_DOCKER_BASE_URL=http://host.docker.internal:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
# Website Token 可以公开，仅用于加载网页聊天插件。
CHATWOOT_WEBSITE_TOKEN=
CUSTOMER_SERVICE_DB_PATH=.runtime/customer-service/state.db
CUSTOMER_SERVICE_WORKER_CONCURRENCY=2
CUSTOMER_SERVICE_JOB_LEASE_SECONDS=300
CUSTOMER_SERVICE_RECONCILE_INTERVAL_SECONDS=60
CUSTOMER_SERVICE_GENERATION_MAX_ATTEMPTS=3
CUSTOMER_SERVICE_DELIVERY_MAX_ATTEMPTS=5
# 人工接管后等待真人公开回复的时限；允许 1..86400 秒，生产建议 300..900 秒。
CUSTOMER_SERVICE_HUMAN_SLA_SECONDS=300
# 超时托底的同会话冷却时间；允许 1..86400 秒，生产建议不小于 SLA。
CUSTOMER_SERVICE_HUMAN_FALLBACK_COOLDOWN_SECONDS=300

# RAG 客服运营看板管理密钥；使用脚本生成，不要手工提交真实值。
OPERATIONS_API_KEY=

# DingTalk native Stream worker. Keep real credentials in .env or a secret store.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=
# V0.3人工工单处理人staffId，必须同时包含在DINGTALK_ALLOWED_USERS中。
DINGTALK_HANDLER_USERS=
# 跨业务板块项目管理员staffId，必须同时包含在DINGTALK_HANDLER_USERS中。
DINGTALK_OPERATOR_USERS=
# 可选：按业务板块指定唯一负责人，例如shareholder=staffId,finance=staffId。
DINGTALK_DOMAIN_HANDLERS=
# 企业内部机器人robotCode；启动脚本会从钉钉控制台自动读取。
DINGTALK_ROBOT_CODE=
DINGTALK_STATE_DB_PATH=.runtime/customer-service/dingtalk.db
DINGTALK_LOG_LEVEL=INFO
# 自动拉协作群目前依赖已登录的DWS用户态；完成真实灰度前保持false。
DINGTALK_AUTO_GROUP_ENABLED=false
DINGTALK_DWS_EXECUTABLE=dws
# 可选：固定corpId:userId，避免服务器存在多个DWS身份时选错账号。
DINGTALK_DWS_PROFILE=
DINGTALK_COLLABORATION_GROUP_PREFIX=内部服务协作

# Optional shareholder 3.0 answer rewriter. Dify remains the evidence source.
OPENCLAW_SHAREHOLDER_ENABLED=false
OPENCLAW_PROJECT_OPERATOR_ENABLED=false
OPENCLAW_GENERAL_CONVERSATION_ENABLED=false
OPENCLAW_GENERAL_AGENT_ID=internal-companion
OPENCLAW_GENERAL_TIMEOUT_SECONDS=30
# 默认继承日常对话开关和 Agent；可单独关闭或调整业务问题追问。
OPENCLAW_BUSINESS_DIALOGUE_ENABLED=false
OPENCLAW_BUSINESS_DIALOGUE_AGENT_ID=internal-companion
OPENCLAW_BUSINESS_DIALOGUE_TIMEOUT_SECONDS=30
OPENCLAW_EXECUTABLE=openclaw
OPENCLAW_SHAREHOLDER_AGENT_ID=shareholder-3-0
OPENCLAW_SHAREHOLDER_THINKING=low
OPENCLAW_SHAREHOLDER_TIMEOUT_SECONDS=90
OPENCLAW_DIALOGUE_TIMEOUT_SECONDS=30
# 文件不存在时自动关闭门店实时查询；本机配置不要提交到 Git。
DINGTALK_STORE_CONFIG_PATH=config/store-directory.local.json
# 本机调试保留 dws；服务器使用 openapi，不依赖个人钉钉登录态。
DINGTALK_STORE_PROVIDER=dws
# openapi 模式必填：对门店宽表有访问权的钉钉用户 unionId。
DINGTALK_STORE_OPERATOR_ID=
