# Docling 解析 API 仅绑定本机。生产环境通过 HTTPS 反向代理访问。
DOCLING_PORT=5001
DOCLING_DEVICE=cpu

# 完成 Dify 管理员初始化并创建知识库 API Key 后再填写。
DIFY_BASE_URL=http://127.0.0.1:8081
# Docling/AI 服务运行在 Docker 内时使用宿主机地址。
DIFY_DOCKER_BASE_URL=http://host.docker.internal:8081
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
# DeepSeek 不提供 embedding API，第一版先用 economy；接入 embedding 模型后改为 high_quality。
DIFY_INDEXING_TECHNIQUE=economy

# Dify Chatflow 应用级密钥，仅供服务端调用，不要放入网页代码。
DIFY_APP_ID=
DIFY_APP_API_KEY=

# Chatwoot AI 客服编排。API Token 与 Webhook Secret 仅保存在服务端。
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_DOCKER_BASE_URL=http://host.docker.internal:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
# Website Token 可以公开，仅用于加载网页聊天插件。
CHATWOOT_WEBSITE_TOKEN=
CUSTOMER_SERVICE_DB_PATH=.runtime/customer-service/state.db
CUSTOMER_SERVICE_WORKER_CONCURRENCY=2
CUSTOMER_SERVICE_JOB_LEASE_SECONDS=300
CUSTOMER_SERVICE_RECONCILE_INTERVAL_SECONDS=60
CUSTOMER_SERVICE_GENERATION_MAX_ATTEMPTS=2
CUSTOMER_SERVICE_DELIVERY_MAX_ATTEMPTS=5
# 人工接管后等待真人公开回复的时限；允许 1..86400 秒，生产建议 300..900 秒。
CUSTOMER_SERVICE_HUMAN_SLA_SECONDS=300
# 超时托底的同会话冷却时间；允许 1..86400 秒，生产建议不小于 SLA。
CUSTOMER_SERVICE_HUMAN_FALLBACK_COOLDOWN_SECONDS=300

# RAG 客服运营看板管理密钥；使用脚本生成，不要手工提交真实值。
OPERATIONS_API_KEY=
